{
  "name": "liga-cna",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && tsc -p tsconfig.functions.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:live": "node scripts/check-live.mjs",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public"
  },
  "dependencies": { "@supabase/supabase-js": "2.116.0" },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "supabase": "2.117.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}

